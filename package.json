{
  "name": "glamping-resort",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "brand": "tsx --env-file=.env scripts/apply-brand.ts",
    "update-content": "tsx --env-file=.env scripts/update-content.ts",
    "admin:set": "tsx --env-file=.env scripts/set-admin.ts",
    "admin:unlock": "tsx --env-file=.env scripts/unlock-login.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "zip": "bash scripts/zip.sh"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
